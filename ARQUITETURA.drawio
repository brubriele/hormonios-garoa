<mxfile host="app.diagrams.net">
  <diagram name="Arquitetura Hormônios × Transicionais" id="hg-arq">
    <mxGraphModel dx="3132" dy="688" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="840" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="nav" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#fce4ec;strokeColor=#d81b60;" value="&lt;b&gt;Navegador&lt;/b&gt;&lt;br&gt;Hormônios da Garoa&lt;br&gt;&lt;br&gt;cookie &lt;i&gt;hg_session&lt;/i&gt;&lt;br&gt;(httpOnly, Lax)" vertex="1">
          <mxGeometry height="130" width="190" x="-20" y="250" as="geometry" />
        </mxCell>
        <mxCell id="vercel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;arcSize=4;fillColor=#f5f5f5;strokeColor=#333333;" value="Vercel (Hobby)" vertex="1">
          <mxGeometry height="540" width="480" x="280" y="40" as="geometry" />
        </mxCell>
        <mxCell id="front" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" value="&lt;b&gt;Front estático (Vite)&lt;/b&gt;&lt;br&gt;index.html · guias.html · app.js" vertex="1">
          <mxGeometry height="70" width="430" x="320" y="85" as="geometry" />
        </mxCell>
        <mxCell id="bff" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;bff-hormonios (Functions)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;App:&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt; GET /api/ensaio · POST /api/reserva · /reserva/desfazer&lt;/span&gt;&lt;/div&gt;&lt;/b&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;GET /api/minhas-reservas · POST /api/sair&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;OAuth2:&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt; POST /api/oauth/{provider} (ida + pré-reserva)&lt;/span&gt;&lt;/div&gt;&lt;/b&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;POST /api/oauth/return (volta, JWE)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Webhooks:&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt; POST /api/webhooks/transicionais&lt;/span&gt;&lt;/div&gt;&lt;/b&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;(HMAC, deliveryId, trava de version / changedAt)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Crons:&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt; GET /api/cron/sync · GET /api/cron/event&lt;/span&gt;&lt;/div&gt;&lt;/b&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;(CRON_SECRET)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;b&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;refreshCurrentEvent()&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff)); font-weight: normal;&quot;&gt;: uma rotina para API e cron&lt;/span&gt;&lt;/div&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="365" width="430" x="320" y="195" as="geometry" />
        </mxCell>
        <mxCell id="cron" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#fff3e0;strokeColor=#f57c00;" value="&lt;b&gt;Cloudflare Worker — agendador&lt;/b&gt;&lt;br&gt;sync: * * * * * · event: */5 * * * *&lt;br&gt;&lt;i&gt;Cloudflare Worker (Cron Trigger, gratuito) · cron/ no repo&lt;/i&gt;" vertex="1">
          <mxGeometry height="80" width="470" x="300" y="620" as="geometry" />
        </mxCell>
        <mxCell id="supa" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#e8f5e9;strokeColor=#2e7d32;" value="&lt;b&gt;Supabase (Postgres, jsonb)&lt;/b&gt;&lt;br&gt;RLS fechada · só service_role pelo BFF&lt;br&gt;&lt;br&gt;hg_users (email único, pronome, transicionais_*, token cifrado)&lt;br&gt;hg_current_event (id = 1, version, vacancies_at)&lt;br&gt;hg_attendances (unique user+dia, PENDING / SYNCED / REJECTED / NEEDS_LOGIN)&lt;br&gt;hg_webhook_deliveries (deliveryId)" vertex="1">
          <mxGeometry height="150" width="520" x="840" y="620" as="geometry" />
        </mxCell>
        <mxCell id="prov" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#e3f2fd;strokeColor=#1565c0;" value="&lt;b&gt;Google / LinkedIn&lt;/b&gt;&lt;br&gt;OAuth2 + PKCE" vertex="1">
          <mxGeometry height="70" width="520" x="840" y="40" as="geometry" />
        </mxCell>
        <mxCell id="tr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;arcSize=4;fillColor=#ede7f6;strokeColor=#5e35b1;" value="Transicionais (Cloudflare tunnel)" vertex="1">
          <mxGeometry height="430" width="520" x="840" y="150" as="geometry" />
        </mxCell>
        <mxCell id="bffr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#ffffff;strokeColor=#5e35b1;" value="&lt;b&gt;bf-front (Next BFF)&lt;/b&gt;&lt;br&gt;POST /api/oauth/{provider} + returnTo + state + pronome&lt;br&gt;callback: não grava guest_token&lt;br&gt;→ POST automático com JWE (60 s) para o Hormônios" vertex="1">
          <mxGeometry height="110" width="480" x="860" y="195" as="geometry" />
        </mxCell>
        <mxCell id="back" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#ffffff;strokeColor=#5e35b1;" value="&lt;b&gt;bf-back (NestJS)&lt;/b&gt;&lt;br&gt;v2/community: evento público, holds, validations/change, tickets, LGPD&lt;br&gt;auth/oauth/{provider}: GUEST_REGISTER&lt;br&gt;pronome em v2_profiles e v2_profile_guest&lt;br&gt;&lt;br&gt;&lt;b&gt;outbox → webhooks&lt;/b&gt;: event.updated · validation.changed&lt;br&gt;aceita IP real do BFF (credencial do cliente)" vertex="1">
          <mxGeometry height="225" width="480" x="860" y="335" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#fffde7;strokeColor=#9e9d24;fontSize=11;" value="&lt;b&gt;Quem é a verdade&lt;/b&gt;&lt;br&gt;Transicionais no ar → Transicionais (Supabase é cache)&lt;br&gt;Transicionais fora → Supabase, até o cron sincronizar&lt;br&gt;Encontro atual → configuração CURRENT_EVENT&lt;br&gt;Gestão (Produção, presença, tornar membro) → painel do Transicionais" vertex="1">
          <mxGeometry height="170" width="230" x="40" y="620" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="nav" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;entryX=0.002;entryY=0.576;entryDx=0;entryDy=0;entryPerimeter=0;" target="front" value="HTML/JS">
          <mxGeometry relative="1" x="-0.8931" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="nav" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" target="bff" value="/api/* (mesma origem)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="bff" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;entryX=0;entryY=0.3;" target="supa" value="SQL (service_role)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="bff" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.55;entryX=0;entryY=0.4;" target="back" value="HTTPS v2/community/*&lt;br&gt;token do convidado + IP real">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="nav" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0;entryY=0.2;strokeColor=#1565c0;" target="bffr" value="① form POST (ida OAuth)">
          <mxGeometry relative="1" x="0.1821" y="17" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="bffr" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#1565c0;startArrow=block;" target="prov" value="② OAuth2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="bffr" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#1565c0;" target="back" value="③ GUEST_REGISTER">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="bffr" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;entryX=1;entryY=0.2;strokeColor=#1565c0;dashed=1;" target="bff" value="④ POST automático (JWE) via navegador">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="back" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.85;entryX=1;entryY=0.85;strokeColor=#5e35b1;dashed=1;" target="bff" value="webhooks assinados (HMAC)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" edge="1" parent="1" source="cron" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#f57c00;" target="bff" value="GET /api/cron/*&lt;br&gt;Bearer CRON_SECRET">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
<diagram name="Etapas faseadas" id="hg-etapas"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1560" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2_1" value="&lt;b&gt;Etapas faseadas — Hormônios × Transicionais&lt;/b&gt;" style="text;html=1;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1520" height="35" as="geometry"/></mxCell><mxCell id="p2_2" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="170" height="40" as="geometry"/></mxCell><mxCell id="p2_3" value="&lt;b&gt;Front (Hormônios)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fce4ec;strokeColor=#d81b60;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="60" width="270" height="40" as="geometry"/></mxCell><mxCell id="p2_4" value="&lt;b&gt;bff-hormonios (+ Supabase)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="60" width="270" height="40" as="geometry"/></mxCell><mxCell id="p2_5" value="&lt;b&gt;bff Transicionais (bf-front)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ede7f6;strokeColor=#5e35b1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="60" width="270" height="40" as="geometry"/></mxCell><mxCell id="p2_6" value="&lt;b&gt;Back-end Transicionais (bf-back)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ede7f6;strokeColor=#5e35b1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="60" width="270" height="40" as="geometry"/></mxCell><mxCell id="p2_7" value="&lt;b&gt;Crons (Cloudflare Worker)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff3e0;strokeColor=#f57c00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="60" width="270" height="40" as="geometry"/></mxCell><mxCell id="p2_8" value="&lt;b&gt;Etapa 1&lt;br&gt;&lt;span style='font-weight:normal'&gt;como se o Transicionais não existisse&lt;br&gt;sem login&lt;/span&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fffde7;strokeColor=#9e9d24;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="170" height="200" as="geometry"/></mxCell><mxCell id="p2_9" value="• sai o localStorage&lt;br&gt;• folha única: e-mail, nome, pronome, instrumento, talabarte/baqueta&lt;br&gt;• Produção edita o ensaio, instrumentos e vagas (chave ADMIN_KEY no lugar da senha garoa)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;strokeColor=#d81b60;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="190" y="100" width="270" height="200" as="geometry"/></mxCell><mxCell id="p2_10" value="• Supabase: hg_current_event, hg_attendances, hg_users (e-mail único, nome, pronome)&lt;br&gt;• GET /api/ensaio · POST /api/reserva · /desfazer · GET /minhas-reservas&lt;br&gt;• id do aparelho em cookie (não é login)&lt;br&gt;• /api/admin/* com ADMIN_KEY" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;strokeColor=#333333;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="460" y="100" width="270" height="200" as="geometry"/></mxCell><mxCell id="p2_11" value="—" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;strokeColor=#5e35b1;fillColor=#fafafa;fontColor=#9e9e9e;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="730" y="100" width="270" height="200" as="geometry"/></mxCell><mxCell id="p2_12" value="—" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;strokeColor=#5e35b1;fillColor=#fafafa;fontColor=#9e9e9e;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="100" width="270" height="200" as="geometry"/></mxCell><mxCell id="p2_13" value="—" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;strokeColor=#f57c00;fillColor=#fafafa;fontColor=#9e9e9e;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1270" y="100" width="270" height="200" as="geometry"/></mxCell><mxCell id="p2_14" value="&lt;b&gt;Etapa 2&lt;br&gt;&lt;span style='font-weight:normal'&gt;integração com a API&lt;br&gt;plano de falha / resiliência&lt;/span&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fffde7;strokeColor=#9e9d24;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="170" height="200" as="geometry"/></mxCell><mxCell id="p2_15" value="• ensaio vem do Transicionais (Produção do Hormônios fica só leitura; WhatsApp segue local)&lt;br&gt;• aviso de ensaio desatualizado (stale)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;strokeColor=#d81b60;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="190" y="300" width="270" height="200" as="geometry"/></mxCell><mxCell id="p2_16" value="• refreshCurrentEvent() pela API pública (CURRENT_EVENT)&lt;br&gt;• POST /api/webhooks/transicionais: HMAC, deliveryId, trava de version / changedAt&lt;br&gt;• hg_webhook_deliveries&lt;br&gt;• GET /api/cron/event&lt;br&gt;• manda o IP real" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;strokeColor=#333333;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="460" y="300" width="270" height="200" as="geometry"/></mxCell><mxCell id="p2_17" value="—" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;strokeColor=#5e35b1;fillColor=#fafafa;fontColor=#9e9e9e;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="730" y="300" width="270" height="200" as="geometry"/></mxCell><mxCell id="p2_18" value="• outbox na mesma transação&lt;br&gt;• webhooks event.updated e validation.changed&lt;br&gt;• aceitar o IP real do BFF (credencial do cliente)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;strokeColor=#5e35b1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1000" y="300" width="270" height="200" as="geometry"/></mxCell><mxCell id="p2_19" value="• Worker: GET /api/cron/event a cada 5 min (Bearer CRON_SECRET)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;strokeColor=#f57c00;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1270" y="300" width="270" height="200" as="geometry"/></mxCell><mxCell id="p2_20" value="&lt;b&gt;Etapa 3&lt;br&gt;&lt;span style='font-weight:normal'&gt;login com código por e-mail&lt;br&gt;sincronização&lt;/span&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fffde7;strokeColor=#9e9d24;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="170" height="200" as="geometry"/></mxCell><mxCell id="p2_21" value="• e-mail → código&lt;br&gt;• status da reserva: confirmada, pendente, recusada, entre para confirmar&lt;br&gt;• Sair" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;strokeColor=#d81b60;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="190" y="500" width="270" height="200" as="geometry"/></mxCell><mxCell id="p2_22" value="• envia o código; cookie hg_session&lt;br&gt;• assina a declaração do e-mail → auth/oauth/hormonios&lt;br&gt;• token cifrado em hg_users&lt;br&gt;• GET /api/cron/sync (claim_pending, travas)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;strokeColor=#333333;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="460" y="500" width="270" height="200" as="geometry"/></mxCell><mxCell id="p2_23" value="• pronome no fluxo do convidado (F1)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;strokeColor=#5e35b1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="730" y="500" width="270" height="200" as="geometry"/></mxCell><mxCell id="p2_24" value="• provedor hormonios (GUEST_REGISTER / GUEST_LOGIN)&lt;br&gt;• ligar contas pelo e-mail verificado na organização (revê R18)&lt;br&gt;• pronome em v2_profiles e v2_profile_guest" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;strokeColor=#5e35b1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1000" y="500" width="270" height="200" as="geometry"/></mxCell><mxCell id="p2_25" value="• Worker: GET /api/cron/sync a cada minuto" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;strokeColor=#f57c00;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1270" y="500" width="270" height="200" as="geometry"/></mxCell><mxCell id="p2_26" value="&lt;b&gt;Etapa 4&lt;br&gt;&lt;span style='font-weight:normal'&gt;login SSO (OAuth2)&lt;br&gt;Google / LinkedIn&lt;/span&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fffde7;strokeColor=#9e9d24;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="170" height="200" as="geometry"/></mxCell><mxCell id="p2_27" value="• botões Continuar com Google / LinkedIn (form POST)&lt;br&gt;• duas telas: folha + provedor" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;strokeColor=#d81b60;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="190" y="700" width="270" height="200" as="geometry"/></mxCell><mxCell id="p2_28" value="• POST /api/oauth/{provider}: ida + pré-reserva, cookie hg_oauth&lt;br&gt;• POST /api/oauth/return: decifra o JWE, confere o state, liga hg_users" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;strokeColor=#333333;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="460" y="700" width="270" height="200" as="geometry"/></mxCell><mxCell id="p2_29" value="• returnTo (id) + state no POST /api/oauth/{provider}&lt;br&gt;• callback sem gravar guest_token&lt;br&gt;• POST automático com JWE (60 s)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;strokeColor=#5e35b1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="730" y="700" width="270" height="200" as="geometry"/></mxCell><mxCell id="p2_30" value="• sem mudança no fluxo (google/linkedin, GUEST_REGISTER, holds)&lt;br&gt;• decidir A1: manter holdToken para o BFF" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;strokeColor=#5e35b1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1000" y="700" width="270" height="200" as="geometry"/></mxCell><mxCell id="p2_31" value="—" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;strokeColor=#f57c00;fillColor=#fafafa;fontColor=#9e9e9e;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1270" y="700" width="270" height="200" as="geometry"/></mxCell><mxCell id="p2_32" value="Etapa 2 não envia reservas ao Transicionais: o envio usa o token de cada pessoa, que só existe a partir do login (etapa 3)." style="text;html=1;fontSize=11;align=left;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="20" y="915" width="1520" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
