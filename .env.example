# Copie para .env.local e preencha. Nunca commite o .env.local.
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.

# Supabase → Project Settings → API: "Project URL" (sem barra no final)
SUPABASE_URL=https://nrbvobwoghcyxqyrhtvw.supabase.co

# Supabase → Project Settings → API: chave service_role (ou secret key sb_secret_...).
# Só no servidor: passa por cima da RLS. Não use a anon nem a publishable.
SUPABASE_SERVICE_ROLE_KEY=

# Chave que a Produção digita no login (POST /api/admin/entrar).
ADMIN_KEY=

# Segredo que assina o cookie hg_admin. Gere com: openssl rand -base64 32
# Trocar desloga a Produção.
COOKIE_KEY=

# Transicionais (fase 2). TRANSICIONAIS_URL vai com o prefixo /apps_nodejs.
# Dev: http://localhost:4500/apps_nodejs ou https://dev-api.transicionais.com.br/apps_nodejs
# Usuário: hormonios-bff (docs/plans/transicionais/setup-hormonios.md). Antes do setup, admin1.
TRANSICIONAIS_USER=
TRANSICIONAIS_PASSWORD=
TRANSICIONAIS_URL="http://localhost:4500/apps_nodejs"

# Encontro atual inicial. Depois de "Encerrar ensaio", o atual fica no Supabase.
CURRENT_EVENT='{"customId":"hormonios-da-garoa","externalId":"","dayId":0}'

# Bearer das rotas /api/cron/* (o mesmo nos secrets do Worker). Gere com: openssl rand -base64 32
CRON_SECRET=

# Chave para conferir o JWT dos webhooks do Transicionais (impressa pelo setup).
TRANSICIONAIS_JWT_KEY=
